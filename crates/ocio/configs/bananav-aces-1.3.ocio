# Written by tools/ocio_config.py: change the script, not this file.
ocio_profile_version: 2.1

environment:
  {}
search_path: ""
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]
name: bananav-aces-1.3
description: |
  BananaV's color management: the Academy Color Encoding System 1.3.
  ACES2065-1 is the scene reference, CIE XYZ (D65) the displays'.
  Written for BananaV; its transforms are OpenColorIO's builtins and standard
  transforms, so other OpenColorIO hosts read it too.

roles:
  aces_interchange: ACES2065-1
  cie_xyz_d65_interchange: CIE-XYZ-D65
  color_picking: sRGB - Texture
  color_timing: ACEScct
  compositing_log: ACEScct
  data: Raw
  default: ACES2065-1
  matte_paint: sRGB - Texture
  scene_linear: ACEScg
  texture_paint: ACEScct

file_rules:
  - !<Rule> {name: Default, colorspace: ACES2065-1}

shared_views:
  - !<View> {name: Un-tone-mapped, view_transform: Un-tone-mapped, display_colorspace: <USE_DISPLAY_NAME>}

displays:
  sRGB:
    - !<View> {name: ACES, view_transform: ACES 1.0 - SDR Video, display_colorspace: sRGB}
    - !<Views> [Un-tone-mapped]
    - !<View> {name: Raw, colorspace: Raw}
  Rec.709:
    - !<View> {name: ACES, view_transform: ACES 1.0 - SDR Video, display_colorspace: Rec.709}
    - !<Views> [Un-tone-mapped]
    - !<View> {name: Raw, colorspace: Raw}
  Rec.2020:
    - !<View> {name: ACES, view_transform: ACES 1.0 - SDR Video, display_colorspace: Rec.2020}
    - !<Views> [Un-tone-mapped]
    - !<View> {name: Raw, colorspace: Raw}
  Display P3:
    - !<View> {name: ACES, view_transform: ACES 1.0 - SDR Video, display_colorspace: Display P3}
    - !<Views> [Un-tone-mapped]
    - !<View> {name: Raw, colorspace: Raw}
  P3-D65:
    - !<View> {name: ACES, view_transform: ACES 1.0 - SDR Cinema, display_colorspace: P3-D65}
    - !<Views> [Un-tone-mapped]
    - !<View> {name: Raw, colorspace: Raw}
  P3-DCI:
    - !<View> {name: ACES, view_transform: ACES 1.0 - SDR Cinema, display_colorspace: P3-DCI}
    - !<Views> [Un-tone-mapped]
    - !<View> {name: Raw, colorspace: Raw}

active_displays: [sRGB, Rec.709, Rec.2020, Display P3, P3-D65, P3-DCI]
active_views: [ACES, Un-tone-mapped, Raw]
inactive_colorspaces: [CIE-XYZ-D65]

looks:
  - !<Look>
    name: ACES 1.3 Reference Gamut Compression
    process_space: ACES2065-1
    description: "Brings the colors outside AP1, the strongest of cameras and lights, inside it."
    transform: !<BuiltinTransform> {style: ACES-LMT - ACES 1.3 Reference Gamut Compression}
  - !<Look>
    name: Blue Light Artifact Fix
    process_space: ACES2065-1
    description: "Desaturates the bright blues of sirens and LEDs, which would clip or shift hue."
    transform: !<BuiltinTransform> {style: ACES-LMT - BLUE_LIGHT_ARTIFACT_FIX}

default_view_transform: Un-tone-mapped

view_transforms:
  - !<ViewTransform>
    name: ACES 1.0 - SDR Video
    description: "The ACES reference rendering and output for video monitors in a dim surround."
    from_scene_reference: !<BuiltinTransform> {style: ACES-OUTPUT - ACES2065-1_to_CIE-XYZ-D65 - SDR-VIDEO_1.0}
  - !<ViewTransform>
    name: ACES 1.0 - SDR Cinema
    description: "The ACES reference rendering and output for cinema projectors in a dark surround."
    from_scene_reference: !<BuiltinTransform> {style: ACES-OUTPUT - ACES2065-1_to_CIE-XYZ-D65 - SDR-CINEMA_1.0}
  - !<ViewTransform>
    name: Un-tone-mapped
    description: "Scene light shown as it is, without a rendering."
    from_scene_reference: !<BuiltinTransform> {style: UTILITY - ACES-AP0_to_CIE-XYZ-D65_BFD}

display_colorspaces:
  - !<ColorSpace>
    name: CIE-XYZ-D65
    aliases: [cie_xyz_d65]
    family: ""
    equalitygroup: ""
    bitdepth: 32f
    description: "The displays' connection space, CIE XYZ under D65, 1 the display's white."
    isdata: false
    categories: [file-io]
    encoding: display-linear

  - !<ColorSpace>
    name: sRGB
    aliases: [sRGB - Display, srgb_display]
    family: Display
    equalitygroup: ""
    bitdepth: 32f
    description: "A computer monitor, sRGB curve and Rec. 709 primaries."
    isdata: false
    categories: [file-io]
    encoding: sdr-video
    from_display_reference: !<BuiltinTransform> {style: DISPLAY - CIE-XYZ-D65_to_sRGB}

  - !<ColorSpace>
